# Compose environment overrides (all optional; defaults are in compose.yaml)
BRANCH=lineage-23.2
DEVICE=guacamole
WORKDIR=/workspace/android
CCACHE_DIR=/ccache
CCACHE_SIZE=250G
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
WG_REPO=https://git.zx2c4.com/wireguard-linux-compat

# Optional: force build parallelism; leave empty to use all CPU threads
# BUILD_JOBS=8
